# Copy to .env and fill in what you have. Every integration credential is optional: without it
# the server still starts and reports the integration as missing. Never commit .env.

# Runtime: development, test or production
APP_ENV=development
APP_VERSION=
HOST=
PORT=8080
LOG_LEVEL=info

# Database: a local SQLite file by default (file:data/moviq.db); libsql://... in production
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Payments: sandbox or live. Live needs production, ADMIN_TOKEN and PayPal credentials.
PAYPAL_ENV=sandbox
PUBLIC_DEMO=false
# Enables the fictional transport partner and traveller entry, only with PayPal Sandbox configured.
TICKET_DEMO_ENABLED=false
# Optional, with TICKET_DEMO_ENABLED: a sandbox billing agreement (B-…) the test buyer approved.
# Every demo traveller then starts connected to it: the assistant buys and the wallet is topped
# up with no PayPal sign-in. Approve one with "Connect PayPal" on the Agent screen and copy the
# agreement id from the `ticket_autopay` table.
PAYPAL_DEMO_AGREEMENT_ID=
# Exposes the sandbox test buyer to demo visitors only when explicitly enabled.
PAYPAL_DEMO_BUYER_ENABLED=false
# Control room access, at least 32 characters each: full access (required in production) and
# read-only access for reviewers. They must differ.
ADMIN_TOKEN=
OPS_VIEWER_TOKEN=

# Worker: how long its lease lasts and how often the hosting probe writes a heartbeat
WORKER_LEASE_TTL_SECONDS=30
WORKER_HEARTBEAT_SECONDS=30

# Recorder: an absolute folder for the compressed recording (without it the recorder does not
# run) and the days of raw recording kept; the nightly aggregates are kept for good
RECORDING_DIR=
RECORDING_RETENTION_DAYS=7

# Tests only (APP_ENV=test): send every provider request to a local server of captures
TEST_PROVIDER_ORIGIN=
# Disposable Sandbox test buyer, also used by the PayPal end-to-end tests.
# Only exposed to demo visitors when PAYPAL_DEMO_BUYER_ENABLED is explicitly true.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# Assistants (Sara and the merchant agent): model and shared daily token budget
OPENAI_MODEL=
ASSISTANT_DAILY_TOKEN_BUDGET=200000

# Commerce on the way: the program's rules (whole percent) and the key that signs pickup codes
# (at least 32 characters; required in production, generated per process elsewhere)
MIN_REWARD_PERCENT=10
PAYOUT_FEE_PERCENT=5
COMMERCE_MAX_CLARIFICATIONS=2
COMMERCE_MAX_OFFER_ATTEMPTS=3
ORDER_CODE_SECRET=

# Merchant demo access: blank disables merchant sign-in. Keep this key private.
MERCHANT_ACCESS_TOKEN=
# Public HTTP(S) origin behind a reverse proxy, without a trailing slash.
PUBLIC_ORIGIN=

# Integrations
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
OPENAI_API_KEY=
MTA_BUSTIME_KEY=
AERODATABOX_KEY=
CHANNEL3_API_KEY=
TICKETMASTER_API_KEY=
DUFFEL_TOKEN=
NLR_API_KEY=
# The Cloudflare recorder (apps/recorder-cf): its address, such as https://<worker>.workers.dev,
# and its TOKEN_LECTURA, to read the statistics it publishes every night
RECORDER_URL=
RECORDER_READ_TOKEN=
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
