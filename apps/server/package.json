{
  "name": "@moviq/server",
  "version": "0.1.0",
  "private": true,
  "description": "MovIQ API and worker processes.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=moviq-source --env-file-if-exists=../../.env src/main.ts",
    "dev:worker": "tsx watch --conditions=moviq-source --env-file-if-exists=../../.env src/worker.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@libsql/client": "0.18.0",
    "@moviq/contracts": "0.1.0",
    "fast-xml-parser": "5.12.0",
    "fflate": "0.8.3",
    "hono": "4.13.17",
    "openai": "7.55.0",
    "protobufjs": "8.8.1",
    "zod": "4.6.7"
  }
}
